{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b60c5779-6f72-479b-afaf-22e2a37c605f","database_name": "web-app5445" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ec0445a3234748c7966cc74ed8536272" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
